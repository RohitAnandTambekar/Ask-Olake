# Copy to .env and fill in. .env is gitignored; never commit real keys.
DATABASE_URL=postgresql://olake:olake@localhost:5433/ask_olake

# ---- Embeddings (ingestion and API must match) ----
# openai: real semantic search (needs OPENAI_API_KEY).
# hashing: no key, no network; word matching only. For tests and offline demos.
# EMBEDDING_DIMS must match vector(N) in the migrations (1536).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
OPENAI_API_KEY=

# ---- Answer generation ----
# auto = OpenRouter if OPENROUTER_API_KEY is set, else Anthropic, else OpenAI,
# else "extractive" (no model: shows the most relevant passages with links).
LLM_PROVIDER=auto
# ---- Inference via OpenRouter (embeddings stay on OpenAI above) ----
# Allowed for our key: google/gemini-2.5-flash-lite, z-ai/glm-4.7-flash, deepseek/deepseek-v4.1-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_SITE_URL=https://olake.io

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Check OpenAI's current model list before relying on this default.
OPENAI_CHAT_MODEL=gpt-4.1-mini

# ---- Public deployment ----
# Origins allowed to call the API from a browser (comma-separated), e.g. https://olake.io
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=5
MAX_CONCURRENT_ANSWERS=8
# Set true only behind a proxy/load balancer that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Random string; used to hash client IPs in the query log.
CLIENT_HASH_SALT=change-me

# ---- Ingestion ----
# Optional: crawl a local copy of the docs site instead of https://olake.io.
# Citations still point at olake.io. Leave unset to crawl the live site.
# SITE_FETCH_BASE=http://localhost:3000
